# Copy to .env and adjust. Never commit real secrets.
# ---- mode ----
# full = PostgreSQL + RabbitMQ (docker compose). lite = SQLite + in-process queue (no Docker).
RUN_MODE=full
# production enforces https + public destinations only
ENVIRONMENT=development

# ---- infrastructure (docker compose defaults) ----
POSTGRES_USER=st
POSTGRES_PASSWORD=st_dev_password
POSTGRES_DB=securetokens
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ---- auth (prototype API keys) ----
ADMIN_API_KEY=st_admin_dev_key
DEMO_API_KEY=st_dev_demo_key
# Fernet key for webhook secrets at rest. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# ---- webhook delivery ----
# DEVELOPMENT ONLY
ALLOW_LOCALHOST_WEBHOOKS=true
DEV_ALLOWED_HOSTS=localhost,127.0.0.1,::1,receiver
# seconds before attempt N+1; first value unused (attempt 1 is immediate). Short demo schedule:
WEBHOOK_RETRY_SCHEDULE=0,5,10,20,30
# Production-style schedule: WEBHOOK_RETRY_SCHEDULE=0,30,120,600,1800
WEBHOOK_TIMEOUT_SECONDS=5

# ---- simulation (demo data) ----
EXECUTION_DELAY_SECONDS=3
RESERVE_INITIAL_BALANCE=10000
POLICY_LIMIT_PER_CLAIM=1000
CREDIT_RATE_PER_1K_TOKENS=5

# ---- sample receiver ----
RECEIVER_ADMIN_TOKEN=receiver_dev_token
